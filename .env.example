PROVIDERS=CPUExecutionProvider
DET_CONF=0.42
EMBED_DIM=512
MAX_OPTIMIZATION_THREADS=1
INDEXING_THRESHOLD=20000
LOW_RAM=true

# Detection / quality thresholds
DET_SCORE_MIN=0.42
MIN_DIVERSITY=0.87
SHARP_MIN=22                 # slightly lower because we measure on small patch
AREA_MIN=0.05
AREA_MAX=0.78
CENTER_TOL=0.28

# Memory-critical
MAX_SIDE=512                 # ← MUST be 640 (or 512 if still OOM)
# MAX_SIDE=512               # use this only if you still hit memory errors

# Enrollment
BURST_TARGET=20              # reduced from 28 (less RAM pressure)
BURST_KEEP=4
ENROLL_ACCEPT=0.68           # slightly more lenient (compensate for light enhance)
BURST_MAX_MS=8000

# Recognition
SIM_THRESHOLD=0.52
TOPK=6                       # 8 → 6 saves a bit of work

FACE_CROP_SCALE=1.35

HOST=0.0.0.0
PORT=7860

QDRANT_URL=https://ea3feff1-1b19-44d0-932f-95bd9d242f71.eu-west-2-0.aws.cloud.qdrant.io
