# ---- copy to .env and edit; real env vars override .env ----

# ONNX execution providers (comma-separated, priority order)
# GPU (Nvidia): CUDAExecutionProvider,CPUExecutionProvider
PROVIDERS=CPUExecutionProvider
DET_CONF=0.45
EMBED_DIM=512

# storage paths (defaults sit under ./data)
# DATA_DIR=/absolute/path/to/data
# INDEX_PATH=/absolute/path/faiss_index.bin
# META_PATH=/absolute/path/faiss_meta.json
# LOGIN_LOG=/absolute/path/login_log.json

# enrollment quality gates
DET_SCORE_MIN=0.48          # slightly more tolerant
MIN_DIVERSITY=0.88          # ← key: allow more different poses
SHARP_MIN=28                # ← key: tolerate grainy / soft frames
AREA_MIN=0.05
AREA_MAX=0.78
CENTER_TOL=0.28

# enrollment burst / selection
BURST_TARGET=28             # more frames to choose from
BURST_KEEP=12               # keep more angles
ENROLL_ACCEPT=0.72          # lower the 80% bar so more frames pass
BURST_MAX_MS=8000

# recognition
SIM_THRESHOLD=0.58
TOPK=8

# server
HOST=0.0.0.0
PORT=8000