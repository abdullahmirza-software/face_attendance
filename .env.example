MIN_DIVERSITY=0.87
SHARP_MIN=25
AREA_MIN=0.05
AREA_MAX=0.78
CENTER_TOL=0.28

# ---- enrollment burst / selection ----
BURST_TARGET=28
BURST_KEEP=12
